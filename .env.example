# Битрикс24
BITRIX_PORTAL_DOMAIN=yourcompany.bitrix24.ru
BITRIX_APPLICATION_TOKEN=your_outgoing_webhook_application_token
BITRIX_INCOMING_WEBHOOK_URL=https://yourcompany.bitrix24.ru/rest/1/xxxxx/

# Пользовательские поля лида (узнайте коды в CRM → Настройки → Пользовательские поля)
BITRIX_FIELD_CITY=UF_CRM_CITY
BITRIX_FIELD_VISA_QUESTIONS=UF_CRM_VISA_QUESTIONS

# MAX Bot API
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=your_max_bot_token
MAX_WEBHOOK_SECRET=your_webhook_secret_min_5_chars

# Код подписки: пользователь пишет /start <код> или открывает бота с ?start=<код>
MAX_SUBSCRIBE_CODE=482917

# Путь к файлам данных на VPS
DATA_DIR=./data

# Опционально: секретный сегмент URL для вебхуков (усложняет угадывание)
WEBHOOK_PATH_SECRET=
